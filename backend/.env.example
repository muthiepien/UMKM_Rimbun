PORT=3000

# Isi dari Aiven Console > service MySQL > Overview > Connection information
DB_HOST=isi-dengan-host-aiven.aivencloud.com
DB_PORT=isi-dengan-port-aiven
DB_USER=avnadmin
DB_PASSWORD=isi-dengan-password-aiven
DB_NAME=rimbun

# Aiven mewajibkan SSL. DB_SSL_CA = lokasi file CA (relatif terhadap folder backend)
DB_SSL=true
DB_SSL_CA=certs/ca.pem

# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=1d
